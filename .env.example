# Kopiér denne fil til ".env.local" og udfyld dine egne værdier.

# Bruges til at signere login-cookies. Skift til en lang tilfældig streng.
SESSION_SECRET=skift-mig-til-en-lang-tilfaeldig-streng

# Firmanavn brugt i SMS/e-mails og på hjemmesiden
COMPANY_NAME=BuildOne

# Base-URL hvor kunder kan tilgå deres statusside, fx https://buildone.dk
PUBLIC_BASE_URL=http://localhost:4100

# --- SMS (valgfrit, udfyld senere) ---
# Eksempel: GatewayAPI (dansk SMS-udbyder, gatewayapi.com)
GATEWAYAPI_API_KEY=

# --- E-mail (valgfrit, udfyld senere) ---
# Eksempel: Resend (resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hej@buildone.dk

# --- CVR system-til-system-adgang (leads-søgning) ---
# Udfyld med de brugeroplysninger, I modtager fra Erhvervsstyrelsen efter
# godkendelse (se https://distribution.virk.dk/cvr-permanent/_mapping for
# datamodellen, når I har fået adgang).
# Bemærk: kun http:// (ikke https://) virker mod ERST's Elasticsearch-API
CVR_API_URL=http://distribution.virk.dk/cvr-permanent/virksomhed/_search
CVR_USERNAME=
CVR_PASSWORD=

# --- Seed: opret første medarbejder (kør: npm run seed) ---
SEED_NAME=Dit Navn
SEED_USERNAME=admin
SEED_PASSWORD=skift-mig
