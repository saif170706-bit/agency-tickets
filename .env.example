# Kopier til .env.local til lokal udvikling.
# På Railway sættes disse under Settings → Variables.

# ── Session-sikkerhed ──────────────────────────────────────────────────────
# Generer med: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=skift-dette-til-en-lang-tilfaeldig-streng

# ── Superadmin (seed-bruger, oprettes automatisk ved første start) ─────────
SEED_NAME=Dit Navn
SEED_USERNAME=admin
SEED_PASSWORD=skift-mig-123

# ── CVR-søgning (Erhvervsstyrelsen) ───────────────────────────────────────
# Opret adgang på: https://datacvr.virk.dk/artikel/system-til-system-adgang-til-cvr-data
CVR_USERNAME=
CVR_PASSWORD=

# ── SearXNG (hjemmesidetjek for leads) ────────────────────────────────────
# Self-hosted på Railway (anbefalet) eller en offentlig instans fra searx.space
SEARXNG_URL=https://din-searxng.railway.app

# ── Brave Search (valgfrit ekstra lag til hjemmesidetjek) ─────────────────
# Gratis 2.000 søgninger/md: https://api.search.brave.com
# BRAVE_SEARCH_API_KEY=
